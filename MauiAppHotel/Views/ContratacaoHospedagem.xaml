<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout
        VerticalOptions="CenterAndExpand"
        Padding="10">
        <Label 
            Text="Cálculo da Diária"
            FontFamily="Kalam"
            FontSize="50"
            TextColor="{StaticResource Primary}"/>
        <Border Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding Value}"
                           TextColor="{StaticResource Primary}"
                           BindingContext="{x:Reference stpAdultos}"/>
                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stpAdultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding Value}"
                           TextColor="{StaticResource Primary}"
                           BindingContext="{x:Reference stpCriancas}"/>
                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stpCriancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />
                </Grid>
                <Label Text="Escolha sua Suíte" />
                <Picker x:Name="pckQuarto"
                        Title="Selecione sua Acomodação" />
                <Border Padding="10" Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Período da Estadia" />
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" />
                            <DatePicker x:Name="dtpckCheckin"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="Check-out:" />
                            <DatePicker x:Name="dtpckCheckout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Avançar" Clicked="Button_Clicked" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>