<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    <VerticalStackLayout
        VerticalOptions="CenterAndExpand"
        Padding="10">
        <Label 
            Text="Suite Super Luxo"
            TextColor="{StaticResource Primary}"
            FontFamily="Kalam"
            FontSize="50"
            HorizontalOptions="Center"/>
        <Border Margin="10">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                <HorizontalStackLayout Margin="10">
                    <Label Text="Adultos:" />
                    <Label Text="10" 
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="10">
                    <Label Text="Crianças:" />
                    <Label Text="10" 
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Border>
        <Border Margin="10">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, *">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia" />
                <Label Grid.Row="1" Grid.Column="0" Text="01/05/2026" TextColor="{StaticResource Primary}" />
                <Label Grid.Row="1" Grid.Column="1" Text="05/05/2026" TextColor="{StaticResource Primary}" />
                <Label Grid.Row="1" Grid.Column="2" Text="5" TextColor="{StaticResource Primary}" />
            </Grid>
        </Border>
        <Border Margin="10">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                <Label Text="Valor Total:" />
                <Label Text="R$ 200,00"
                       TextColor="{StaticResource Primary}" />
            </HorizontalStackLayout>
        </Border>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                MinimumWidthRequest="100"
                Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>