<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource Gray200Brush}">
    <VerticalStackLayout
        VerticalOptions="CenterAndExpand"
        Padding="10">
        <Label 
            Text="{Binding QuartoSelecionado.Descricao}"
            TextColor="{StaticResource Primary}"
            FontFamily="Kalam"
            FontSize="50"
            HorizontalOptions="Center"/>
        <Border MinimumHeightRequest="400" Padding="2" Background="{StaticResource Gray100Brush}">
            <VerticalStackLayout>
                <Border Padding="10">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">
                        <Label HorizontalTextAlignment="Center" 
                               Text="Adultos"
                               Grid.Row="0" Grid.Column="0" />
                        <Label HorizontalTextAlignment="Center"
                               Text="Crianças" 
                               Grid.Row="0" Grid.Column="1" />
                        <Label HorizontalTextAlignment="Center"
                               Text="{Binding QtdAdultos, StringFormat='{}{0:N0}'}" 
                               Grid.Row="1" Grid.Column="0"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}" />
                        <Label HorizontalTextAlignment="Center"
                               Text="{Binding QtdCriancas, StringFormat='{}{0:N0}'}"
                               Grid.Row="1" Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}" />
                    </Grid>
                </Border>
                <Border Padding="10">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, auto">
                        <Label Grid.Row="0" Grid.Column="0" 
                               HorizontalTextAlignment="Center" 
                               Text="Check-In" />
                        <Label Grid.Row="0" Grid.Column="1" 
                               HorizontalTextAlignment="Center" 
                               Text="Check-Out" />
                        <Label Grid.Row="0" Grid.Column="2" 
                               HorizontalTextAlignment="Center" 
                               Text="Estadia" />
                        <Label Grid.Row="1" Grid.Column="0" 
                               HorizontalTextAlignment="Center" 
                               Text="{Binding DataCheckin, StringFormat='{}{0:dd/MM/yyyy}'}" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}" />
                        <Label Grid.Row="1" Grid.Column="1" 
                               HorizontalTextAlignment="Center" 
                               Text="{Binding DataCheckout, StringFormat='{}{0:dd/MM/yyyy}'}" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}" />
                        <Label Grid.Row="1" Grid.Column="2" 
                               HorizontalTextAlignment="Center" 
                               Text="{Binding Estadia, StringFormat='{}{0:N0}'}" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}" />
                    </Grid>
                </Border>
                <Border Padding="10">
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*, *">
                        <Label HorizontalOptions="StartAndExpand" 
                               Text="Valor Total" 
                               Grid.Row="0" Grid.Column="0" />
                        <Label HorizontalOptions="EndAndExpand" 
                               Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               Grid.Row="0" Grid.Column="1"/>
                    </Grid>
                </Border>

                <Button Text="Voltar" Margin="10" 
                        HorizontalOptions="Center"
                        MinimumWidthRequest="100"
                        Clicked="Button_Clicked" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>